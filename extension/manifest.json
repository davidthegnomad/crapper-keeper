{
  "manifest_version": 3,
  "key": "",
  "name": "Crapper Keeper",
  "version": "1.1.0",
  "description": "Get your 💩 together. Right-click any webpage to save it to Crapper Keeper.",
  "permissions": ["contextMenus", "storage", "identity"],
  "host_permissions": ["https://*.googleapis.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Crapper Keeper"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
