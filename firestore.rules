rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }
    function isValidNew() {
      return isSignedIn()
        && request.resource.data.userId == request.auth.uid;
    }
    function ownerUnchanged() {
      return request.resource.data.userId == resource.data.userId;
    }

    match /notebooks/{docId} {
      allow get: if isSignedIn() && (
        !exists(/databases/$(database)/documents/notebooks/$(docId))
        || resource.data.userId == request.auth.uid
      );
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isValidNew();
      allow update: if isOwner() && ownerUnchanged();
      allow delete: if isOwner();
    }
    match /sections/{docId} {
      allow get: if isSignedIn() && (
        !exists(/databases/$(database)/documents/sections/$(docId))
        || resource.data.userId == request.auth.uid
      );
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isValidNew();
      allow update: if isOwner() && ownerUnchanged();
      allow delete: if isOwner();
    }
    match /sectionGroups/{docId} {
      allow get: if isSignedIn() && (
        !exists(/databases/$(database)/documents/sectionGroups/$(docId))
        || resource.data.userId == request.auth.uid
      );
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isValidNew();
      allow update: if isOwner() && ownerUnchanged();
      allow delete: if isOwner();
    }
    match /vaults/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list: if false;
      allow create, update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.userId == userId
        && request.resource.data.ciphertext is string
        && request.resource.data.salt is string
        && request.resource.data.iv is string
        && request.resource.data.iterations is int
        && request.resource.data.ciphertext.size() < 400000
        && request.resource.data.salt.size() < 128
        && request.resource.data.iv.size() < 128;
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }
    match /pages/{docId} {
      allow get: if isSignedIn() && (
        !exists(/databases/$(database)/documents/pages/$(docId))
        || resource.data.userId == request.auth.uid
      );
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isValidNew();
      allow update: if isOwner() && ownerUnchanged();
      allow delete: if isOwner();
    }
  }
}
